---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const featuredProjects = projects.filter((project) => project.data.featured);
const earlierProjects = projects.filter((project) => !project.data.featured);
const base = import.meta.env.BASE_URL;
---

<BaseLayout>
  <header class="site-header"><div class="shell nav-wrap"><a class="wordmark" href="#top" aria-label="Mauricio Rodriguez Alas, home">MRA<span>.</span></a><div class="nav-actions"><nav aria-label="Main navigation"><a href="#work">Work</a><a href="#research">Research</a><a href="#writing">Writing</a><a href="#contact">Contact</a></nav><button class="theme-toggle" type="button" aria-label="Switch colour theme" aria-pressed="false"><span aria-hidden="true">◐</span><span class="theme-toggle__label">Theme</span></button></div></div></header>
  <main id="content">
    <section class="hero shell" id="top" aria-labelledby="hero-title">
      <div class="eyebrow"><span></span> Luxembourg · Europe</div>
      <div class="hero-grid"><div><p class="overline">Research engineer / doctoral researcher</p><h1 id="hero-title">Building reliable intelligence for <em>complex systems.</em></h1></div><div class="hero-side"><p>AI researcher and software engineer working across LLM-assisted software engineering, autonomous systems, and scientific instrumentation.</p><div class="hero-links" aria-label="Contact links"><a href="https://github.com/mrodriguezalas" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a><a href="mailto:mauricio.rodriguez.alas@gmail.com">Email <span aria-hidden="true">↗</span></a><a href={`${base}documents/mauricio-rodriguez-alas-cv.pdf`} target="_blank">CV <span aria-hidden="true">↓</span></a></div><figure class="hero-visual"><img src={`${base}images/hero-instrumentation.png`} alt="Conceptual image of scientific instrumentation, sensing hardware and a satellite-like structure" width="1122" height="1400" loading="eager" /><figcaption>Conceptual visual — instrumentation, sensing & autonomous systems.</figcaption></figure></div></div>
      <div class="signal-panel" aria-label="Current focus areas"><span>LLM agents</span><span>Software reliability</span><span>Autonomous systems</span><span>Space & scientific systems</span></div>
    </section>
    <section class="intro shell section-rule" aria-labelledby="profile-title"><p class="section-kicker">01 / Profile</p><div><h2 id="profile-title">From electronics to AI, with systems thinking at the center.</h2><p class="lede">I am a PhD candidate in Computer Science at the University of Luxembourg, focused on AI-assisted software engineering and software reliability. My engineering background spans embedded systems, space payloads, scientific computing, and computer vision.</p></div></section>
    <section class="work shell section-rule" id="work" aria-labelledby="work-title">
      <div class="section-heading"><div><p class="section-kicker">02 / Selected work</p><h2 id="work-title">A technical trajectory.</h2></div><p>Presented in reverse chronological order, these projects trace a progression from foundational engineering to current research. Each project is maintained as an individual record, keeping the portfolio easy to extend.</p></div>
      <div class="timeline">{featuredProjects.map((project, index) => <article class:list={['project-card', { 'project-card--offset': index % 2 === 1 }]}><div class="project-date">{project.data.date}</div><div class="project-marker" aria-hidden="true"></div><div class="project-body"><div class="project-meta"><span>{project.data.category}</span><span>{project.data.organization}</span></div><h3>{project.data.title}</h3><p>{project.data.summary}</p><div class="tags">{project.data.tags.map((tag) => <span>{tag}</span>)}</div><div class="project-links">{project.data.externalUrl && <a href={project.data.externalUrl} target="_blank" rel="noreferrer">Source <span aria-hidden="true">↗</span></a>}{project.data.paperUrl && <a href={project.data.paperUrl} target="_blank" rel="noreferrer">Paper / record <span aria-hidden="true">↗</span></a>}</div></div></article>)}</div>
      <div class="earlier-work"><div><p class="overline">Earlier work</p><h3>Foundations in scientific computing, vision & instrumentation.</h3></div><div class="earlier-list">{earlierProjects.map((project) => <article><p>{project.data.date}</p><h4>{project.data.shortTitle}</h4><span>{project.data.organization}</span>{project.data.externalUrl && <a href={project.data.externalUrl} target="_blank" rel="noreferrer" aria-label={`Open ${project.data.title}`}>↗</a>}</article>)}</div></div>
    </section>
    <section class="research shell section-rule" id="research" aria-labelledby="research-title"><p class="section-kicker">03 / Research</p><div class="research-grid"><div><h2 id="research-title">AI-assisted software engineering, grounded in execution.</h2></div><div><p class="lede">My current research investigates how LLM agents can support integration testing in distributed software systems. The aim is execution-aware assistance that improves observability, test coverage, and confidence in system behaviour.</p><ul class="research-list"><li>LLM-assisted test generation</li><li>Agentic workflows & software reliability</li><li>Integration testing & distributed systems</li><li>Execution feedback, context & test oracles</li></ul><div class="research-submissions"><p class="annotation">Current submissions</p><ul><li><span>Submitted to the ISSRE 2026 Industry Track</span><strong>LLM-based Integration Test Suite Augmentation for Microservice-based Systems in the Space Domain</strong></li><li><span>Submitted to the SEDES 2026 Doctoral Symposium</span><strong>Automated Testing of Software Services for Autonomous Space Operations</strong></li></ul></div></div></div></section>
    <section class="writing shell section-rule" id="writing" aria-labelledby="writing-title"><div class="section-heading"><div><p class="section-kicker">04 / Publications & presentations</p><h2 id="writing-title">Selected publications and presentations.</h2></div></div><div class="publication-list"><article><span>2024 / Thesis</span><div><h3>Single Event Effects Instrumentation for System-on Module Testing</h3><p>Mauricio Ernesto Rodriguez Alas · RADMEP master’s thesis</p></div><a href="https://jyx.jyu.fi/jyx/Record/jyx_123456789_97356" target="_blank" rel="noreferrer">Read ↗</a></article><article><span>2023 / Conference article</span><div><h3>Project MUSA: A Systems Engineering Approach to Biological Experimentation in Microgravity</h3><p>C. Rodriguez, V. Dittel, M. F. del Barco, M. Rodriguez, S. Ramirez & J. Carvajal · IAC proceedings</p></div><a href="https://orion.tec.ac.cr/en/publications/project-musa-a-systems-engineering-approach-to-biological-experim/" target="_blank" rel="noreferrer">Record ↗</a></article><article><span>2021 / CERN summer project</span><div><h3>Variable Scanning for Physics Efficiency Improvement in Upstream Tracking and Trackmatching Validation Algorithms in the Allen Framework</h3><p>CERN LHCb</p></div><a href="https://cds.cern.ch/record/2790691" target="_blank" rel="noreferrer">Read ↗</a></article><article><span>2020 / Conference presentation</span><div><h3>Very Large Array Sky Survey Quicklook Image Classifier using PyTorch</h3><p>Astronomical Data Analysis Software and Systems (ADASS)</p></div><a href="https://www.aspbooks.org/publications/532/223.pdf" target="_blank" rel="noreferrer">Read ↗</a></article></div></section>
    <section class="path shell section-rule" aria-labelledby="path-title"><p class="section-kicker">05 / Academic path</p><div class="path-grid"><h2 id="path-title">A multidisciplinary route to reliable autonomous systems.</h2><ol><li><b>2025—</b> PhD in Computer Science <span>University of Luxembourg</span></li><li><b>2022—24</b> RADMEP, Erasmus Mundus <span>Radiation effects on microelectronics & photonics</span></li><li><b>2015—21</b> Engineering degrees <span>Electronics, automation & software engineering</span></li></ol></div></section>
    <section class="contact shell" id="contact" aria-labelledby="contact-title"><p class="section-kicker">06 / Contact</p><div class="contact-grid"><div><h2 id="contact-title">I welcome research conversations and technically ambitious collaborations.</h2></div><div><a class="email-link" href="mailto:mauricio.rodriguez.alas@gmail.com">mauricio.rodriguez.alas@gmail.com <span>↗</span></a><p>Based in Luxembourg and working across Europe.</p><a class="text-link" href="https://github.com/mrodriguezalas" target="_blank" rel="noreferrer">github.com/mrodriguezalas ↗</a></div></div></section>
  </main>
  <footer class="site-footer"><div class="shell"><span>© {new Date().getFullYear()} Mauricio Rodriguez Alas</span><span>Designed for clarity, built to evolve.</span></div></footer>
</BaseLayout>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const applyTheme = (theme: 'light' | 'dark') => {
    document.documentElement.dataset.theme = theme;
    localStorage.setItem('theme', theme);
    toggle?.setAttribute('aria-pressed', String(theme === 'dark'));
  };
  applyTheme(document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
  toggle?.addEventListener('click', () => applyTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'));
</script>
